{
  "name": "chaos-theory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An AI-directed top-down party survival arena game.",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,green \"vite\" \"node --watch-path=server server/index.js\"",
    "dev:web": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "dotenv": "^18.0.8",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=20"
  }
}
