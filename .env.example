# Server-side only. NEVER prefix these with VITE_ — they must not reach the browser.
# The chaos director runs on Gemma 4 (open-weight). Pick ONE of the two options below.
# With neither configured, the game runs fully offline with its built-in event generator.

# Option A — Gemma 4 via the Gemini API (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it

# Option B — Gemma 4 running locally with Ollama (no key, fully open-weight)
#   ollama pull gemma4:e2b-it-qat
# OLLAMA_MODEL=gemma4:e2b-it-qat
# OLLAMA_URL=http://127.0.0.1:11434

# Force a provider when both are set: gemini | ollama
# AI_PROVIDER=

# Max time per AI request (ms). Requests are prefetched, so gameplay never waits.
# Local CPU inference is slow — use 60000+ for Ollama without a GPU.
AI_TIMEOUT_MS=10000
PORT=8787
