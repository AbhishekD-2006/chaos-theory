# Server-side only. NEVER prefix these with VITE_ — they must not reach the browser.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model used by the chaos director (must be available to your key)
GEMINI_MODEL=gemini-2.5-flash
# Milliseconds before the server gives up and the client falls back to offline events
AI_TIMEOUT_MS=4000
# API server port (Vite proxies /api here in dev)
PORT=8787
